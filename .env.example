# Als Stack-Variablen in Portainer setzen (oder nach .env kopieren für docker compose).
# Niemals eine echte .env committen.

# Digital Republic API
DR_BASE_URL=https://api.example.com/dr
DR_CLIENT_ID=your-client-id
DR_CLIENT_SECRET=your-client-secret

# Pflicht (Server startet sonst nicht).
# Erzeugen mit: openssl rand -hex 32
# Jeder Request muss dann senden: Authorization: Bearer <dieser Wert>
MCP_API_KEY=

# Optional:
# DR_TOKEN_URL=https://api.example.com/dr/oauth/token   (Standard: <DR_BASE_URL>/oauth/token)
# DR_SCOPE=read write                                    (Standard: kein scope-Parameter)
# DR_TIMEOUT=30
# LOG_LEVEL=INFO
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
# MCP_HOST_PORT=8425

# Bind-Adresse auf dem Docker-Host (Port-Mapping). Standard 127.0.0.1 - auf die
# Host-IP setzen, die der Reverse-Proxy anspricht, z.B.:
# MCP_BIND_ADDR=192.0.2.10
